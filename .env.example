# Neon PostgreSQL Connection String
# Get this from your Neon Console (e.g. postgresql://user:password@ep-sample-123.us-east-2.aws.neon.tech/neondb?sslmode=require)
DATABASE_URL=

# One-time setup key for POST /api/auth/hash-password. Keep this private.
PASSWORD_HASH_API_KEY=generate-a-long-random-setup-key

# JWT Secret for Admin Session Verification (generate a long random value)
JWT_SECRET=generate-a-long-random-jwt-secret
